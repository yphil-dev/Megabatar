code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_vtx_2;
uniform float Displace;
uniform vec4 BaseColor : source_color;
uniform sampler2D tex_frg_7;
uniform float Alpha;
uniform vec4 EmmissionColor : source_color;
uniform float EmStr;



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Input:7
	vec3 n_out7p0 = NORMAL;


// Input:13
	vec2 n_out13p0 = UV;


// Input:11
	float n_out11p0 = TIME;


// VectorOp:14
	vec3 n_in14p1 = vec3(0.00000, -0.50000, 0.00000);
	vec3 n_out14p0 = vec3(n_out11p0) * n_in14p1;


// VectorOp:12
	vec2 n_out12p0 = n_out13p0 + vec2(n_out14p0.xy);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_vtx_2, n_out12p0);


// VectorOp:8
	vec3 n_out8p0 = n_out7p0 * vec3(n_out2p0.xyz);


// FloatParameter:10
	float n_out10p0 = Displace;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out8p0.xy) * vec2(n_out10p0);


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 + vec3(n_out9p0, 0.0);


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// ColorParameter:23
	vec4 n_out23p0 = BaseColor;


// Input:26
	vec2 n_out26p0 = UV;


// VectorOp:27
	vec3 n_in27p0 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in27p1 = vec3(0.00000, 1.00000, 0.00000);
	vec3 n_out27p0 = n_in27p0 * n_in27p1;


// VectorOp:25
	vec3 n_out25p0 = vec3(n_out26p0, 0.0) + n_out27p0;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, vec2(n_out25p0.xy));


// FloatParameter:9
	float n_out9p0 = Alpha;


// FloatOp:12
	float n_in12p0 = 0.00000;
	float n_out12p0 = n_in12p0 + n_out9p0;


// VectorOp:11
	vec2 n_out11p0 = vec2(n_out7p0.xy) * vec2(n_out12p0);


// FloatFunc:8
	float n_out8p0 = round(n_out11p0.x);


// ColorParameter:14
	vec4 n_out14p0 = EmmissionColor;


// FloatParameter:29
	float n_out29p0 = EmStr;


// VectorOp:28
	vec3 n_out28p0 = vec3(n_out14p0.xyz) * vec3(n_out29p0);


// Output:0
	ALBEDO = vec3(n_out23p0.xyz);
	ALPHA = n_out8p0;
	EMISSION = n_out28p0;


}
