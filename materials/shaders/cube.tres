code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_5;
uniform float Speed = 8;



void fragment() {
// ColorConstant:3
	vec4 n_out3p0 = vec4(0.960784, 0.000000, 0.000000, 1.000000);


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


// FloatParameter:10
	float n_out10p0 = Speed;


// Input:6
	float n_out6p0 = TIME;


// FloatOp:11
	float n_out11p0 = n_out10p0 * n_out6p0;


// FloatFunc:7
	float n_out7p0 = sin(n_out11p0);


	float n_out9p0;
// Remap:9
	float n_in9p1 = -1.00000;
	float n_in9p2 = 1.00000;
	float n_in9p3 = 0.00000;
	float n_in9p4 = 1.00000;
	{
		float __input_range = n_in9p2 - n_in9p1;
		float __output_range = n_in9p4 - n_in9p3;
		n_out9p0 = n_in9p3 + __output_range * ((n_out7p0 - n_in9p1) / __input_range);
	}


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out5p0.x;
	ALPHA_SCISSOR_THRESHOLD = n_out9p0;


}
